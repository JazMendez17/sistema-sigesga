# Copia este archivo a .env en la carpeta raíz de la aplicación en HostGator.
# Sustituye los valores de ejemplo. Nunca subas el .env real a GitHub.

APP_NAME=SIGESGA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.sigesga.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANEL_PREFIJO_sigesga
DB_USERNAME=CPANEL_PREFIJO_usuario
DB_PASSWORD=CAMBIA_ESTA_CLAVE

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Mantén log hasta tener una cuenta SMTP configurada en HostGator.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@sigesga.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Llaves opcionales: agrega llaves nuevas y restringidas a este dominio.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_FRONTEND_KEY=
GOOGLE_MAPS_COUNTRY=MX
GOOGLE_MAPS_LANGUAGE=es
GOOGLE_MAPS_VEHICLE_TYPE=TRUCK

POSTALIA_API_KEY=
POSTALIA_BASE_URL=https://postali.app/api/v1
