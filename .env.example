APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=base_sigesga
DB_USERNAME=root
DB_PASSWORD=
# MYSQL_ATTR_SSL_CA="./certs/isrgrootx1.pem"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Google Maps Platform (módulo de cotización de grúas) ──────────────────
# 1) GOOGLE_MAPS_API_KEY        → Llave de SERVIDOR. Habilita en Google Cloud
#    Console la API "Routes API". El backend la usa con el header X-Goog-Api-Key
#    y X-Goog-FieldMask para calcular rutas alternativas, distancias y peajes.
#    Restricción recomendada: solo-IP de tu servidor (o "Ninguna"/Application
#    restrictions si el servidor no tiene IP fija) + limitar a la API Routes API.
#
# 2) GOOGLE_MAPS_FRONTEND_KEY   → Llave de NAVEGADOR. Habilita "Maps JavaScript
#    API" y "Places API". Restricción OBLIGATORIA: "HTTP referrers" con los
#    dominios de tu app (http://localhost:8000/*, https://tu-dominio.com/*) y
#    habilita solo esas 2 APIs.
#
# 3) GOOGLE_MAPS_COUNTRY        → Restringe autocomplete y región (default MX).
# 4) GOOGLE_MAPS_LANGUAGE       → Idioma de respuestas (default es).
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_FRONTEND_KEY=
GOOGLE_MAPS_COUNTRY=MX
GOOGLE_MAPS_LANGUAGE=es
